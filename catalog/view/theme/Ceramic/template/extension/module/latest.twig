<div class="box">
	<div class="container-fluid">
		<div class="row">
  <div class="box-heading">{{ heading_title }}</div>
  <div class="box-content">
	<div class="box-product productbox-grid" id="latest-grid">
  {% for product in products %}
  <div class="product-items">
    <div class="product-block product-thumb transition">
	  <div class="product-block-inner">
			<div class="image">
			{% if product.thumb_swap %}
					<a href="{{ product.href }}">
					<img src="{{ product.thumb }}" title="{{ product.name }}" alt="{{ product.name }}" class="img-responsive reg-image"/>
					<div class="image_content"><img class="img-responsive hover-image" src="{{ product.thumb_swap }}" title="{{ product.name }}" alt="{{ product.name }}"/></div>
					</a>
					{% else %}
					<a href="{{ product.href }}">
					<img src="{{ product.thumb }}" title="{{ product.name }}" alt="{{ product.name }}" class="img-responsive"/></a>
			{% endif %}

			<div class="product_hover_block">
				 <button class="compare_button" type="button"  title="{{ button_compare }} " onclick="compare.add('{{ product.product_id }} ');"></button>
				 <div class="quickview-button">
							<a class="quickbox"  title="{{ button_quickview }}" href="{{ product.quick }}"></a>
				 </div>
				 <button class="wishlist" type="button"  title="{{ button_wishlist }} " onclick="wishlist.add('{{ product.product_id }} ');"></button>
			</div>
			</div>
      	<div class="product-details">
			<div class="caption">
				<h4><a href="{{ product.href }}">{{ product.name }}</a></h4>
				{% if product.price %}
        			<p class="price">
       			    {% if not product.special %}
          			{{ product.price }}
         			{% else %}
         			<span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>
			        {% endif %}
  		            {% if product.tax %}
		            <span class="price-tax">{{ text_tax }} {{ product.tax }}</span>
          			{% endif %}
			        </p>
	            {% endif %}
	            <div class="action">
	               {% if not product.on_hold %}
	               <button type="button" class="cart_button" onclick="cart.add('{{ product.product_id }}');" title="{{ button_cart }}">{{ button_cart }}</button>
	               {% else %}
	               <button type="button" class="cart_button on_hold" title="{{ text_on_hold }}">{{ text_on_hold }}</button>
	               {% endif %}
	            </div>
			</div>
	  	</div>
  	</div>
	</div>
</div>
 {% endfor %}
</div>
  </div>
</div>
</div>
<div class="row">
	<div class="col-sm-12">
		<p style="margin-top: 15px; font-size: 18px; font-weight: 500; letter-spacing: 0.5px; color: #333;">Miguel Meirelles Antiques website has daily updates on new arrivals, newly restored items for sale and also any items that are placed on hold or sold are updated immediately, so that all that is on display is available.</p>
	</div>
</div>
</div>
<span class="latest_default_width" style="display:none; visibility:hidden"></span>
