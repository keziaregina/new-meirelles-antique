{{ header }}
<div id="product-special" class="container">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% set grid_class = 'product-layout product-grid col-lg-6 col-md-6 col-sm-12 col-xs-12' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% set grid_class = 'product-layout product-grid col-lg-3 col-md-4 col-sm-4 col-xs-6' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% set grid_class = 'product-layout product-grid col-lg-3 col-md-3 col-sm-6 col-xs-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">
      <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
      {{ content_top }}
     
	     
      {% if thumb  or  description %} 
      <div class="row category_thumb">
          {% if thumb %}
          <div class="col-sm-3 category_img"><img src="{{ thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-thumbnail" /></div>
          {% endif %}

          <div class="{{ thumb ? 'col-sm-9' : 'col-sm-12' }}">
            <h2 class="page-title">{{ heading_title }}</h2>
            {% if description %}
            <div class="category_description">{{ description }}</div>
            {% endif %}

          </div>
      </div>
      {% endif %}

      {% if products %}
      <div class="category_filter">
        <div class="col-md-4 btn-list-grid">
          <div class="btn-group">
             <button type="button" id="grid-view" class="btn btn-default grid"  title="{{ button_grid }}"><i class="fa fa-th"></i></button>
            <button type="button" id="list-view" class="btn btn-default list" title="{{ button_list }}"><i class="fa fa-th-list"></i></button>
           
          </div>
        </div>
    <div class="pagination-right">
     {% if categories %}
     <div class="category-wrapper">
      <div class="col-md-2 text-right category-by">
        <label class="control-label" for="input-category">{{ text_refine }}</label>
      </div>
      <div class="col-md-3 text-right category-select">
        <select id="input-category" class="form-control" onchange="location = this.value;">
          <option value="" disabled selected>{{ text_refine }}</option>
          {% for category in categories %}
            <option value="{{ category.href }}">{{ category.name }}</option>
          {% endfor %}
        </select>
      </div>
     </div>
     {% endif %}
     <div class="sort-by-wrapper">
      <div class="col-md-2 text-right sort-by">
        <label class="control-label" for="input-sort">{{ text_sort }}</label>
      </div>
      <div class="col-md-3 text-right sort">
        <select id="input-sort" class="form-control" onchange="location = this.value;">
        {% for sorts in sorts %} 
        {% if sorts.value == '%s-%s'|format(sort, order) %}
        <option value="{{ sorts.href }} " selected="selected">{{ sorts.text }}</option>
        {% else %}
        <option value="{{ sorts.href }} ">{{ sorts.text }} </option>
         {% endif %}
        {% endfor %}
        </select>
      </div>
     </div>
     
      </div>
    </div>
    <div class="row cat_prod" data-total="{{ products_total }}" data-page="1" data-perpage="{{ products_per_page }}" data-loadurl="{{ ajax_url }}">
        {% for product in products %}
        <div class="{{ grid_class }}">
          <div class="product-block product-thumb transition">
            <div class="product-block-inner">
              <div class="image {% if product.qty == 0 %}outstock{% endif %}">
                {% if product.thumb_swap %}
                  <a href="{{ product.href }}">
                    <img src="{{ product.thumb }}" title="{{ product.name }}" alt="{{ product.name }}" class="img-responsive reg-image"/>
                    <div class="image_content"><img class="img-responsive hover-image" src="{{ product.thumb_swap }}" title="{{ product.name }}" alt="{{ product.name }}"/></div>
                  </a>
                {% else %}
                  <a href="{{ product.href }}">
                    <img src="{{ product.thumb }}" title="{{ product.name }}" alt="{{ product.name }}" class="img-responsive"/>
                  </a>
                {% endif %}
                {% if product.special %}
                  <span class="special-tag">{{ product.percentsaving }}%</span>
                {% endif %}
                {% if product.qty == 0 %}
                  <span class="stock_status">{{ text_outstock }}</span>
                {% endif %}
                <div class="product_hover_block">
                  <div class="quickview-button">
                    <a class="quickbox" title="{{ button_quickview }}" href="{{ product.quick }}"></a>
                  </div>
                  <button class="wishlist" type="button" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }} ');"></button>
                </div>
              </div>
              <div class="product-details">
                <div class="caption">
                  <h4><a href="{{ product.href }}">{{ product.name }}</a></h4>
                  <p class="description">{{ product.description }}</p>
                  {% if product.rating %}
                    <div class="rating">
                      {% for i in 1..5 %}
                        {% if product.rating < i %}
                          <span class="fa fa-stack"><i class="fa fa-star off fa-stack-2x"></i></span>
                        {% else %}
                          <span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i><i class="fa fa-star-o fa-stack-2x"></i></span>
                        {% endif %}
                      {% endfor %}
                      &nbsp;<span style="cursor:pointer;" class="total-review{{ product.product_id }}">({{ product.review }})</span>
                    </div>
                  {% endif %}
                  {% if product.price %}
                    <p class="price">
                      {% if not product.special %}
                        {{ product.price }}
                      {% else %}
                        <span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>
                      {% endif %}
                    </p>
                  {% endif %}
                  <div class="action">
                    {% if product.qty > 0 and not product.on_hold %}
                      <button type="button" data-product-id="{{ product.product_id }}" class="cart_button btn-crt{% if product.cart_has_product %} has-cart{% endif %}" onclick="cart.add('{{ product.product_id }}');" title="{{ button_cart }}">{{ button_cart }}</button>
                    {% elseif product.on_hold %}
                      <button type="button" class="cart_button on_hold" title="{{ text_on_hold }}">{{ text_on_hold }}</button>
                    {% else %}
                      <button type="button" class="cart_button out_of_stock" title="{{ text_outstock }}">{{ text_outstock }}</button>
                    {% endif %}
                    <a class="btn-more-info" href="{{ product.href }}" title="{{ button_more_info }}">{{ button_more_info }}</a>
                  </div>
                </div>
                <div class="product_hover_block">
                  <div class="quickview-button">
                    <a class="quickbox" title="{{ button_quickview }}" href="{{ product.quick }}"></a>
                  </div>
                  <button class="wishlist" type="button" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }} ');"></button>
                </div>
              </div>
              <div class="product-price-actions">
                {% if product.price %}
                  <p class="price">
                    {% if not product.special %}
                      {{ product.price }}
                    {% else %}
                      <span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span>
                    {% endif %}
                  </p>
                {% endif %}
                <div class="action">
                  {% if product.qty > 0 and not product.on_hold %}
                    <button type="button" data-product-id="{{ product.product_id }}" class="cart_button btn-crt{% if product.cart_has_product %} has-cart{% endif %}" onclick="cart.add('{{ product.product_id }}');" title="{{ button_cart }}">{{ button_cart }}</button>
                  {% elseif product.on_hold %}
                    <button type="button" class="cart_button on_hold" title="{{ text_on_hold }}">{{ text_on_hold }}</button>
                  {% else %}
                    <button type="button" class="cart_button out_of_stock" title="{{ text_outstock }}">{{ text_outstock }}</button>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
        <script> 
            $('.total-review{{ product.product_id }}').on('click', function() { 
             var t='{{product.href}}'; 
            const parseResult = new DOMParser().parseFromString(t, "text/html");
            const parsedUrl = parseResult.documentElement.textContent;
            window.location.href = parsedUrl + '&review';
            return false;
          });
      </script>
  {% endfor %}</div>
      {# <div class="pagination-wrapper">
        <div class="col-sm-6 text-right page-result">{{ results }}</div>  
      <div class="col-sm-6 text-left page-link">{{ pagination }}</div>
      
     </div> #}  
      {% else %}
      <p>{{ text_empty }}</p>
      <div class="buttons">
        <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
      </div>
      {% endif %}
      {{ content_bottom }}</div>
      <div id="load-spinner" style="display:none;text-align:center;padding:20px">
        <img src="catalog/view/theme/Ceramic/image/webdigify/bouncing-circles.svg" alt="Loading..." />
      </div>
<script>
var isLoading = false;
var hasMore = true;
var currentPage = 1;
var $container = $('.cat_prod');
var loadUrl = $container.data('loadurl');

var sentinel = document.createElement('div');
document.querySelector('.cat_prod').after(sentinel);

var observer = new IntersectionObserver(function(entries) {
  if (entries[0].isIntersecting && hasMore && !isLoading) {
    isLoading = true;
    currentPage++;
    $('#load-spinner').show();
    $.get(loadUrl + '&page=' + currentPage, function(res) {
      if (res.products) {
        $container.append(res.products);
        hasMore = res.hasMore;
        var cols = $('#column-right, #column-left').length;
        if (cols == 2) {
          $('#content .product-list').attr('class', 'product-layout product-grid col-lg-6 col-md-6 col-sm-12 col-xs-12');
        } else if (cols == 1) {
          $('#content .product-list').attr('class', 'product-layout product-grid col-lg-3 col-md-4 col-sm-4 col-xs-6');
        } else {
          $('#content .product-list').attr('class', 'product-layout product-grid col-lg-3 col-md-3 col-sm-6 col-xs-12');
        }
      }
      $('#load-spinner').hide();
      isLoading = false;
    });
  }
});
observer.observe(sentinel);
</script>
      {{ column_right }}</div>
</div>
</div>
</div>

{{ footer }}