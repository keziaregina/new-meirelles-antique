<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ heading_title }}</title>
<style>
    :root {
        --primary-bg: #fff;
        --primary-color: #69251c;
        --secondary-color: #ab837e;
        --hover-color: #500c03;
        --fs-h2: 32px;
        --fs-h3: 24px;
        --fs-body: 16px;
        --fs-small: 14px;
    }

    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Times New Roman', serif;
        color: #000;
        font-size: var(--fs-body);
        line-height: 22px;
        letter-spacing: 0.4px;
        margin: 0;
        padding: 40px;
    }

    /* Toolbar (hidden when printing) */
    .no-print {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 999;
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f7f2f1;
        border-bottom: 1px solid #e0d2cf;
        padding: 10px 24px;
    }

    .no-print .toolbar-title {
        font-family: 'Times New Roman', serif;
        font-size: var(--fs-small);
        color: var(--primary-color);
        margin-right: auto;
    }

    .no-print button {
        font-family: 'Times New Roman', serif;
        font-size: var(--fs-body);
        background: var(--primary-color);
        color: #fff;
        border: 0;
        border-radius: 4px;
        padding: 8px 20px;
        cursor: pointer;
    }

    .no-print button:hover {
        background: var(--hover-color);
    }

    .print-wrap {
        max-width: 920px;
        margin: 70px auto 0;
    }

    .product-print-title {
        font-family: 'Times New Roman', serif;
        font-size: 44px;
        line-height: 1.2;
        font-weight: 400;
        color: var(--primary-color);
        margin: 0 0 24px;
    }

    .product-image {
        text-align: center;
        margin: 0 0 30px;
    }

    .product-image img {
        max-width: 100%;
        max-height: 520px;
        width: auto;
        height: auto;
    }

    .section {
        margin: 0 0 30px;
        page-break-inside: avoid;
    }

    .section h2 {
        font-family: 'Times New Roman', serif;
        font-size: var(--fs-h2);
        font-weight: 500;
        color: var(--primary-color);
        line-height: 1.2;
        letter-spacing: 0.4px;
        margin: 0 0 12px;
        border-bottom: 2px solid var(--secondary-color);
        padding-bottom: 6px;
    }

    table.info-table {
        width: 100%;
        border-collapse: collapse;
    }

    table.info-table td {
        font-family: 'Times New Roman', serif;
        font-size: var(--fs-body);
        color: #000;
        padding: 8px 12px;
        border: 1px solid #d8c9c6;
        vertical-align: top;
    }

    table.info-table td.label {
        width: 32%;
        font-weight: 700;
        background: #f7f2f1;
        color: var(--primary-color);
    }

    .price-block h3 {
        font-family: 'Times New Roman', serif;
        font-size: var(--fs-h3);
        font-weight: 400;
        color: #000;
        margin: 0;
        line-height: 1.3;
    }

    .price-block .old-price {
        text-decoration: line-through;
        font-size: var(--fs-body);
        color: #555;
        font-weight: 400;
    }

    .discount-per {
        font-size: var(--fs-body);
        color: var(--hover-color);
    }

    .on-hold-label {
        display: inline-block;
        margin-top: 10px;
        padding: 6px 14px;
        font-size: var(--fs-small);
        color: #8a6d3b;
        background: #fcf8e3;
        border: 1px solid #faebcc;
        border-radius: 4px;
    }

    .status-available {
        color: #000;
        font-weight: 700;
    }

    .status-sold {
        color: #ff0000;
        font-weight: 700;
    }

    /* Neutralise inline Word styles inside description */
    #product-print-description p,
    #product-print-description span,
    #product-print-description div,
    #product-print-description li,
    #product-print-description h1,
    #product-print-description h2,
    #product-print-description h3,
    #product-print-description h4,
    #product-print-description h5,
    #product-print-description h6,
    #product-print-description td {
        font-family: 'Times New Roman', serif !important;
        color: #000 !important;
        font-size: var(--fs-body) !important;
        line-height: 22px !important;
        letter-spacing: 0.4px !important;
        background: transparent !important;
    }

    .images-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 12px;
    }

    .images-grid .image-item {
        flex: 1 1 200px;
        max-width: 200px;
        page-break-inside: avoid;
    }

    .images-grid .image-item img {
        width: 100%;
        height: auto;
        display: block;
        border: 1px solid #e0d2cf;
        padding: 4px;
        background: #fff;
    }

    .error-page h1 {
        font-family: 'Times New Roman', serif;
        font-size: var(--fs-h2);
        color: var(--primary-color);
        margin: 0 0 16px;
    }

    @media print {
        body {
            padding: 0;
        }

        .no-print {
            display: none !important;
        }

        .print-wrap {
            margin: 0 auto;
        }

        @page {
            margin: 18mm;
        }
    }
</style>
</head>
<body>
<div class="no-print">
    <span class="toolbar-title">{{ heading_title }}</span>
    <button onclick="window.print(); return false;">Print</button>
    <button onclick="window.close(); return false;">Close</button>
</div>

<div class="print-wrap">
    {% if error %}
    <div class="error-page">
        <h1>{{ heading_title }}</h1>
        <p>{{ text_error }}</p>
    </div>
    {% else %}
    {% if heading_title %}
    <h1 class="product-print-title">{{ heading_title }}</h1>
    {% endif %}

    {% if on_hold %}
    <div class="section">
        <span class="on-hold-label">{{ text_on_hold }}</span>
    </div>
    {% endif %}

    {% if thumb %}
    <div class="product-image">
        <img src="{{ thumb }}" alt="{{ heading_title }}" />
    </div>
    {% endif %}

    <div class="section">
        <h2>Product Details</h2>
        <table class="info-table">
            {% if manufacturer %}
            <tr>
                <td class="label">{{ text_manufacturer }}</td>
                <td>{{ manufacturer }}</td>
            </tr>
            {% endif %}
            {% if model %}
            <tr>
                <td class="label">{{ text_model }}</td>
                <td>{{ model }}</td>
            </tr>
            {% endif %}
            {% if price %}
            <tr>
                <td class="label">Price</td>
                <td class="price-block">
                    {% if not special %}
                    <h3>{{ price }} <small>including GST</small></h3>
                    {% else %}
                    <h3>{{ special }} <span class="old-price">{{ price }}</span> <span class="discount-per">{{ percentsaving }}% off</span></h3>
                    {% endif %}
                </td>
            </tr>
            {% endif %}
            <tr>
                <td class="label">{{ text_stock }}</td>
                <td class="{{ stock_qty == 'true' ? 'status-available' : 'status-sold' }}">{{ stock_qty == 'true' ? 'Available' : 'Sold' }}{% if stock_qty == 'false' and stock %} &mdash; {{ stock }}{% endif %}</td>
            </tr>
            <tr>
                <td class="label">Location</td>
                <td>{% if shipping_local_collection and collection_location %}{{ collection_location }}{% else %}-{% endif %}</td>
            </tr>
            <tr>
                <td class="label">Delivery &amp; Collection</td>
                <td>
                    {%- if shipping_local_collection %}Local Collection{% endif -%}
                    {%- if shipping_australia_post %}{% if shipping_local_collection or shipping_courier %}, {% endif %}Australia Post{% endif -%}
                    {%- if shipping_courier %}{% if shipping_local_collection or shipping_australia_post %}, {% endif %}Courier{% endif -%}
                    {%- if not shipping_local_collection and not shipping_australia_post and not shipping_courier %}-{% endif -%}
                    {% if shipping_courier %}
                    <br>International delivery can also be arranged. Please contact us for further information.
                    {% endif %}
                </td>
            </tr>
        </table>
    </div>

    {% if description %}
    <div class="section" id="product-print-description">
        <h2>{{ tab_description }}</h2>
        {{ description }}
    </div>
    {% endif %}

    {% if _dimensions or _condition_report %}
    <div class="section">
        <h2>{{ tab_attribute }}</h2>
        <table class="info-table">
            {% if _dimensions %}
            <tr>
                <td class="label">Dimension</td>
                <td>{{ _dimensions }}</td>
            </tr>
            {% endif %}
            {% if _condition_report %}
            <tr>
                <td class="label">Condition Report</td>
                <td>{{ _condition_report }}</td>
            </tr>
            {% endif %}
        </table>
    </div>
    {% endif %}

    {% if images %}
    <div class="section">
        <h2>Product Images</h2>
        <div class="images-grid">
            {% for image in images %}
            <div class="image-item">
                <img src="{{ image.popup }}" alt="{{ heading_title }}" />
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
    {% endif %}
</div>

<script>
window.addEventListener('load', function () {
    var closed = false;

    var closeWindow = function () {
        if (closed) {
            return;
        }
        closed = true;
        window.close();
    };

    window.onafterprint = closeWindow;

    if (window.matchMedia) {
        var mql = window.matchMedia('print');
        var handler = function (mqlEvent) {
            if (!mqlEvent.matches) {
                closeWindow();
            }
        };
        if (mql.addListener) {
            mql.addListener(handler);
        } else if (mql.addEventListener) {
            mql.addEventListener('change', handler);
        }
    }

    setTimeout(function () {
        window.print();
    }, 400);
});
</script>
</body>
</html>