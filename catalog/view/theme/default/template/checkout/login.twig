<div class="contact-section">
  <div class="form-group">
    <label class="control-label" for="input-email">{{ entry_email_address }}</label>
    <input type="email" name="email" value="" placeholder="{{ entry_email_address }}" id="input-email" class="form-control" />
  </div>
  <div class="checkbox">
    <label>
      <input type="checkbox" name="newsletter" value="1" />
      {{ text_newsletter }}
    </label>
  </div>
  <div class="contact-signin" style="margin-top: 10px;">
    <a href="{{ login_url }}">{{ text_sign_in }}</a>
  </div>
</div>
<script type="text/javascript">
$('#input-email').on('blur', function() {
  var email = $(this).val();
  if (email && email.indexOf('@') > -1) {
    $.ajax({
      url: 'index.php?route=checkout/checkout/save_guest_email',
      type: 'post',
      data: 'email=' + encodeURIComponent(email),
      dataType: 'json',
      success: function() {
        updateCheckoutOrder();
      }
    });
  }
});
</script>
