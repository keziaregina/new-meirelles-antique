{{ header }}
<div id="checkout-checkout" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ heading_title }}</h1>

      <div class="checkout-sections">
        <div class="checkout-section" id="section-contact">
          <h3>{{ text_contact }}</h3>
          <div class="section-content"></div>
        </div>

        <div class="checkout-section" id="section-delivery">
          <h3>{{ text_delivery }}</h3>
          <div class="delivery-toggle">
            <button type="button" class="toggle-btn active" data-target="shipping">Delivery Methods</button>
            <button type="button" class="toggle-btn" data-target="local-pickup">Local Collection</button>
          </div>
          <div class="section-content">
            <div id="delivery-shipping" class="delivery-panel active">
              <div id="delivery-shipping-address">
                <div class="panel-loading"><i class="fa fa-spinner fa-spin"></i> Loading...</div>
              </div>
              {% if shipping_required %}
              <div id="delivery-shipping-method-section" class="delivery-subsection">
                <h4>Shipping Method</h4>
                <div class="section-content">
                  <div class="panel-loading"><i class="fa fa-spinner fa-spin"></i> Loading...</div>
                </div>
              </div>
              {% endif %}
            </div>
            <div id="delivery-local-pickup" class="delivery-panel">
              {% for location in pickup_locations %}
              <div class="pickup-card">
                <label class="pickup-option">
                  <input type="radio" name="collection_location_id" value="{{ location.collection_location_id }}" {{ loop.first ? 'checked="checked"' : '' }} />
                  <div class="pickup-info">
                    <strong>{{ location.name }}</strong>
                    <span>{{ location.address_1 }}, {{ location.city }}</span>
                    <span>{{ location.phone }}</span>
                  </div>
                </label>
              </div>
              {% endfor %}
              <div class="pickup-schedule">
                <label class="control-label" for="select-pickup-datetime">Select Date Time</label>
                <select id="select-pickup-datetime" name="pickup_datetime" class="form-control">
                  <option value="">-- Select a date time --</option>
                  <option value="earliest">{{ earliest_available_text }}</option>
                  <option value="custom">Choose date and time...</option>
                </select>

                <div id="custom-datetime" class="custom-datetime-picker" style="display:none;">
                  <div class="form-group">
                    <label class="control-label" for="pickup-date">Select Date</label>
                    <input type="date" id="pickup-date" name="pickup_date" class="form-control" min="" />
                  </div>
                  <div class="form-group">
                    <label class="control-label" for="pickup-time">Select Time</label>
                    <select id="pickup-time" name="pickup_time" class="form-control">
                      <option value="">-- Select Time --</option>
                      <option value="09:00-11:00">Time: 9.00am - 11.00am</option>
                      <option value="11:00-13:00">Time: 11.00am - 1.00pm</option>
                      <option value="13:00-15:00">Time: 1.00pm - 3.00pm</option>
                      <option value="15:00-17:00">Time: 3.00pm - 5.00pm</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="checkout-section" id="section-payment-method">
          <h3>Payment</h3>
          <div class="section-content"></div>
        </div>

        <div class="checkout-section" id="section-billing">
          <h3>Billing Address</h3>
          <div class="billing-options">
            <div class="billing-card">
              <label class="billing-card-option">
                <input type="radio" name="billing_address" value="same" checked="checked" />
                <div class="billing-card-info">
                  <strong>Same as Shipping Address</strong>
                  <span>Your billing address will match your shipping address</span>
                </div>
              </label>
            </div>
            <div class="billing-card">
              <label class="billing-card-option">
                <input type="radio" name="billing_address" value="different" />
                <div class="billing-card-info">
                  <strong>Use Different Billing Address</strong>
                  <span>Enter a separate address for billing</span>
                </div>
              </label>
            </div>
          </div>
          <div id="billing-different" class="billing-panel"></div>
        </div>

        <div id="section-place-order" class="checkout-section">
          <div class="place-order-actions">
            <div id="payment-button-container">
              <button type="button" id="button-place-order" class="btn btn-primary btn-block btn-place-order" disabled>Choose payment method</button>
            </div>
            <label class="agree-checkbox">
              {# <input type="checkbox" name="agree" value="1" /> #}
              <span>I have read and agree to the <a href="/index.php?route=information/information&information_id=3" target="_blank"><strong>Terms &amp; Conditions</strong></a></span>
            </label>
          </div>
        </div>
      </div>

      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
<script type="text/javascript"><!--
$(document).ready(function() {
  // Load Contact section
  $.ajax({
    url: 'index.php?route=checkout/login',
    dataType: 'html',
    success: function(html) {
      $('#section-contact .section-content').html(html);
    },
    error: function(xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });

  // Toggle tabs
  $('.toggle-btn').on('click', function() {
    var target = $(this).data('target');
    $('.toggle-btn').removeClass('active');
    $(this).addClass('active');
    $('.delivery-panel').removeClass('active');
    $('#delivery-' + target).addClass('active');

    if (target == 'local-pickup') {
      forceBillingDifferent();
      savePickup();
    } else {
      resetBillingDefault();
    }
  });

  // Custom datetime picker toggle
  $(document).on('change', '#select-pickup-datetime', function() {
    if ($(this).val() == 'custom') {
      $('#custom-datetime').show();
      var today = new Date().toISOString().split('T')[0];
      $('#pickup-date').attr('min', today);
    } else {
      $('#custom-datetime').hide();
      $('#pickup-date').val('');
      $('#pickup-time').val('');
    }
  });

  // Bypass customSelect plugin for pickup datetime selects
  setTimeout(function() {
    $('#select-pickup-datetime, #pickup-time').each(function() {
      var $select = $(this);
      $select.removeAttr('style').removeClass('hasCustomSelect');
      $select.next('.customSelect').remove();
    });
  }, 500);

  // Auto-save pickup location
  $(document).on('change', 'input[name="collection_location_id"]', function() {
    savePickup();
  });

  // Auto-save pickup datetime
  $(document).on('change', '#select-pickup-datetime', function() {
    savePickup();
  });

  $(document).on('change', '#pickup-time', function() {
    savePickup();
  });

  function savePickup() {
    var locationId = $('input[name="collection_location_id"]:checked').val();
    var datetime = $('#select-pickup-datetime').val();
    var pickupDate = $('#pickup-date').val();
    var pickupTime = $('#pickup-time').val();

    if (!locationId) return;

    if (datetime == 'custom' && pickupDate && pickupTime) {
      datetime = pickupDate + ' ' + pickupTime;
    } else if (datetime == 'custom') {
      return;
    }

    $.ajax({
      url: 'index.php?route=checkout/checkout/save_pickup',
      type: 'post',
      data: {
        collection_location_id: locationId,
        pickup_datetime: datetime
      },
      dataType: 'json',
      success: function(json) {
        if (json.error) {
          alert(json.error);
        } else {
          reloadPaymentMethods();
        }
      }
    });
  }

  function forceBillingDifferent() {
    $('.billing-options').hide();
    $('input[name="billing_address"][value="different"]').prop('checked', true);
    $('#billing-different').show();

    if (!$('#billing-different').html().trim()) {
      $.ajax({
        url: 'index.php?route=checkout/payment_address',
        dataType: 'html',
        success: function(html) {
          $('#billing-different').html(html);
        }
      });
    }
  }

  function resetBillingDefault() {
    $('.billing-options').show();
    $('input[name="billing_address"][value="same"]').prop('checked', true);
    $('#billing-different').hide();
    $('#billing-different').html('');
  }

  // Load Delivery section (using shipping address form)
  $.ajax({
    url: 'index.php?route=checkout/shipping_address',
    dataType: 'html',
    success: function(html) {
      $('#delivery-shipping-address').html(html);
    },
    error: function(xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });

  {% if shipping_required %}
  // Load Shipping Method section
  $.ajax({
    url: 'index.php?route=checkout/shipping_method',
    dataType: 'html',
    success: function(html) {
      $('#delivery-shipping-method-section .section-content').html(html);
    },
    error: function(xhr, ajaxOptions, thrownError) {
      alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
    }
  });
  {% endif %}

  // Billing address toggle
  $('input[name=\'billing_address\']').on('change', function() {
    if (this.value == 'different') {
      $('#billing-different').show();
      $.ajax({
        url: 'index.php?route=checkout/payment_address',
        dataType: 'html',
        success: function(html) {
          $('#billing-different').html(html);
        },
        error: function(xhr, ajaxOptions, thrownError) {
          alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
      });
    } else {
      $('#billing-different').hide();
      $('#billing-different').html('');
      syncShippingToPayment();
    }
  });

  function syncShippingToPayment() {
    $.ajax({
      url: 'index.php?route=checkout/checkout/copy_shipping_to_payment',
      type: 'post',
      dataType: 'json',
      success: function(json) {
        if (!json['redirect']) {
          reloadPaymentMethods();
        }
      }
    });
  }

  function reloadPaymentMethods() {
    $.ajax({
      url: 'index.php?route=checkout/payment_method',
      dataType: 'html',
      success: function(html) {
        $('#section-payment-method .section-content').html(html);
        var paymentMethodVal = $('#section-payment-method input[name=\'payment_method\']:checked').val();
        if (!paymentMethodVal) {
          paymentMethodVal = $('#section-payment-method input[name=\'payment_method\']:first').val();
          if (paymentMethodVal) {
            $('#section-payment-method input[name=\'payment_method\']:first').prop('checked', true);
          }
        }
        if (paymentMethodVal) {
          var commentVal = $('#delivery-shipping-method-section textarea[name=\'comment\']').val() || '';
          $.ajax({
            url: 'index.php?route=checkout/payment_method/save',
            type: 'post',
            data: 'payment_method=' + encodeURIComponent(paymentMethodVal) + '&comment=' + encodeURIComponent(commentVal) + '&agree=1',
            dataType: 'json',
            success: function(json) {
              if (!json['redirect'] && !json['error']) {
                loadPaymentButton();
              }
            }
          });
        }
      }
    });
  }

  // Save billing address (when "Different" is selected)
  $(document).delegate('#button-payment-address', 'click', function() {
    $.ajax({
      url: 'index.php?route=checkout/checkout/save_payment_address',
      type: 'post',
      data: $('#billing-different input[type=\'text\'], #billing-different input[type=\'date\'], #billing-different input[type=\'datetime-local\'], #billing-different input[type=\'time\'], #billing-different input[type=\'checkbox\']:checked, #billing-different input[type=\'radio\']:checked, #billing-different input[type=\'hidden\'], #billing-different textarea, #billing-different select'),
      dataType: 'json',
      beforeSend: function() {
        $('#button-payment-address').button('loading');
      },
      success: function(json) {
        $('.alert-dismissible, .text-danger').remove();
        $('.form-group').removeClass('has-error');

        if (json['redirect']) {
          location = json['redirect'];
        } else if (json['error']) {
          $('#button-payment-address').button('reset');

          if (json['error']['warning']) {
            $('#billing-different').prepend('<div class="alert alert-warning alert-dismissible">' + json['error']['warning'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
          }

          for (i in json['error']) {
            var element = $('#billing-different #input-payment-' + i.replace('_', '-'));

            if ($(element).parent().hasClass('input-group')) {
              $(element).parent().after('<div class="text-danger">' + json['error'][i] + '</div>');
            } else {
              $(element).after('<div class="text-danger">' + json['error'][i] + '</div>');
            }
          }

          $('.text-danger').parent().addClass('has-error');
        } else {
          updateCheckoutOrder();
          reloadPaymentMethods();
        }
      },
      error: function(xhr, ajaxOptions, thrownError) {
        alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
      }
    });
  });

  // Auto-save billing address when fields change
  var autoSaveBillingTimer = null;
  $(document).on('input change', '#billing-different input[type=\'text\'], #billing-different select', function() {
    clearTimeout(autoSaveBillingTimer);
    autoSaveBillingTimer = setTimeout(function() {
      var form = $('#billing-different');
      var required = ['firstname', 'lastname', 'address_1', 'city', 'country_id', 'zone_id'];
      var valid = true;
      for (var i = 0; i < required.length; i++) {
        var el = form.find('[name=\'' + required[i] + '\']');
        if (!el.val()) {
          valid = false;
          break;
        }
      }

      if (valid) {
        autoSavePaymentAddress();
      }
    }, 600);
  });

  function autoSavePaymentAddress() {
    $.ajax({
      url: 'index.php?route=checkout/checkout/save_payment_address',
      type: 'post',
      data: $('#billing-different input[type=\'text\'], #billing-different input[type=\'date\'], #billing-different input[type=\'datetime-local\'], #billing-different input[type=\'time\'], #billing-different input[type=\'checkbox\']:checked, #billing-different input[type=\'radio\']:checked, #billing-different input[type=\'hidden\'], #billing-different textarea, #billing-different select'),
      dataType: 'json',
      success: function(json) {
        if (!json['redirect'] && !json['error']) {
          reloadPaymentMethods();
          updateCheckoutOrder();
        }
      }
    });
  }

  // Auto-save shipping address when required fields change
  var autoSaveTimer = null;
  $(document).on('input change', '#delivery-shipping-address input[type=\'text\'], #delivery-shipping-address select', function() {
    clearTimeout(autoSaveTimer);
    autoSaveTimer = setTimeout(function() {
      var form = $('#delivery-shipping-address');
      var existing = form.find('input[name=\'shipping_address\']:checked').val();

      if (existing === 'existing') {
        autoSaveShippingAddress();
        return;
      }

      var required = ['firstname', 'lastname', 'address_1', 'city', 'country_id', 'zone_id'];
      var valid = true;
      for (var i = 0; i < required.length; i++) {
        var el = form.find('[name=\'' + required[i] + '\']');
        if (!el.val()) {
          valid = false;
          break;
        }
      }

      if (valid) {
        autoSaveShippingAddress();
      }
    }, 600);
  });

  function autoSaveShippingAddress() {
    $.ajax({
      url: 'index.php?route=checkout/checkout/save_shipping_address',
      type: 'post',
      data: $('#delivery-shipping-address input[type=\'text\'], #delivery-shipping-address input[type=\'hidden\'], #delivery-shipping-address select'),
      dataType: 'json',
      success: function(json) {
        if (!json['redirect']) {
          {% if shipping_required %}
          $.ajax({
            url: 'index.php?route=checkout/shipping_method',
            dataType: 'html',
            success: function(html) {
              $('#delivery-shipping-method-section .section-content').html(html);

              var shippingMethodVal = $('#delivery-shipping-method-section input[name=\'shipping_method\']:checked').val();
              if (shippingMethodVal) {
                var commentVal = $('#delivery-shipping-method-section textarea[name=\'comment\']').val() || '';
                $.ajax({
                  url: 'index.php?route=checkout/shipping_method/save',
                  type: 'post',
                  data: 'shipping_method=' + encodeURIComponent(shippingMethodVal) + '&comment=' + encodeURIComponent(commentVal),
                  dataType: 'json',
                  success: function(json) {
                    updateCheckoutOrder();
                    if ($('input[name=\'billing_address\']:checked').val() == 'same') {
                      syncShippingToPayment();
                    }
                  }
                });
              }
            }
          });
          {% else %}
          if ($('input[name=\'billing_address\']:checked').val() == 'same') {
            syncShippingToPayment();
          }
          {% endif %}
        }
      }
    });
  }

  // Auto-clear validation errors on input
  $(document).on('input change', '#checkout-checkout input, #checkout-checkout select, #checkout-checkout textarea', function() {
    var formGroup = $(this).closest('.form-group');
    if (formGroup.hasClass('has-error')) {
      formGroup.removeClass('has-error');
      formGroup.find('.text-danger').remove();
    }
    // Clear section-level errors
    var section = $(this).closest('.checkout-section');
    if (section.hasClass('has-error') && section.find('.form-group.has-error').length === 0) {
      section.removeClass('has-error');
    }
  });
});

function loadPaymentButton() {
  $('#payment-button-container').html('<div class="panel-loading"><i class="fa fa-spinner fa-spin"></i> Loading...</div>');
  $.ajax({
    url: 'index.php?route=checkout/checkout/payment_button',
    dataType: 'json',
    success: function(json) {
      if (json['payment']) {
        $('#payment-button-container').html(json['payment']);
      } else {
        $('#payment-button-container').html('');
    }
  },
    error: function() {
      $('#payment-button-container').html('');
    }
  });
}

function updateCheckoutOrder() {
  validateCheckoutFields();
  $.ajax({
    url: 'index.php?route=checkout/checkout/update_order',
    type: 'post',
    dataType: 'json'
  });
}

function validateCheckoutFields() {
  $('#checkout-checkout .text-danger').remove();
  $('#checkout-checkout .form-group').removeClass('has-error');
  $('#delivery-shipping-method-section, #section-payment-method').removeClass('has-error');

  var errors = [];

  // Contact - Email
  var emailEl = $('#section-contact input[name="email"]');
  if (emailEl.length && !emailEl.val()) {
    markError(emailEl);
    errors.push('email');
  }

  // Shipping Address
  var shippingMode = $('#delivery-shipping-address input[name="shipping_address"]:checked').val();
  if (shippingMode === 'new') {
    var requiredShipping = ['firstname', 'lastname', 'address_1', 'city', 'country_id', 'zone_id'];
    for (var i = 0; i < requiredShipping.length; i++) {
      var el = $('#delivery-shipping-address [name="' + requiredShipping[i] + '"]');
      if (el.length && !el.val()) {
        markError(el);
        errors.push(requiredShipping[i]);
      }
    }
  } else if (shippingMode === 'existing') {
    var addrId = $('#delivery-shipping-address select[name="address_id"]').val();
    if (!addrId) {
      errors.push('address_id');
    }
  }

  // Shipping Method
  var shippingMethod = $('#delivery-shipping-method-section input[name="shipping_method"]:checked').val();
  if (!shippingMethod) {
    errors.push('shipping_method');
    $('#delivery-shipping-method-section').addClass('has-error');
  }

  // Payment Method
  var paymentMethod = $('#section-payment-method input[name="payment_method"]:checked').val();
  if (!paymentMethod) {
    errors.push('payment_method');
    $('#section-payment-method').addClass('has-error');
  }

  // Billing Address (if "different")
  var billingMode = $('input[name="billing_address"]:checked').val();
  if (billingMode === 'different') {
    var requiredBilling = ['firstname', 'lastname', 'address_1', 'city', 'country_id', 'zone_id'];
    for (var i = 0; i < requiredBilling.length; i++) {
      var el = $('#billing-different [name="' + requiredBilling[i] + '"]');
      if (el.length && !el.val()) {
        markError(el);
        errors.push('billing_' + requiredBilling[i]);
      }
    }
  }

  return errors;
}

function markError(el) {
  var formGroup = el.closest('.form-group');
  if (formGroup.length) {
    formGroup.addClass('has-error');
    if (!formGroup.find('.text-danger').length) {
      el.after('<div class="text-danger">This field is required</div>');
    }
  }
}

// Guest
$(document).delegate('#button-guest', 'click', function() {
    $.ajax({
        url: 'index.php?route=checkout/guest/save',
        type: 'post',
        data: $('#delivery-shipping input[type=\'text\'], #delivery-shipping input[type=\'date\'], #delivery-shipping input[type=\'datetime-local\'], #delivery-shipping input[type=\'time\'], #delivery-shipping input[type=\'checkbox\']:checked, #delivery-shipping input[type=\'radio\']:checked, #delivery-shipping input[type=\'hidden\'], #delivery-shipping textarea, #delivery-shipping select'),
        dataType: 'json',
        beforeSend: function() {
       		$('#button-guest').button('loading');
	    },
        success: function(json) {
            $('.alert-dismissible, .text-danger').remove();
			$('.form-group').removeClass('has-error');

            if (json['redirect']) {
                location = json['redirect'];
            } else if (json['error']) {
                $('#button-guest').button('reset');

                if (json['error']['warning']) {
                    $('#delivery-shipping-address').prepend('<div class="alert alert-warning alert-dismissible">' + json['error']['warning'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                }

				for (i in json['error']) {
					var element = $('#input-payment-' + i.replace('_', '-'));

					if ($(element).parent().hasClass('input-group')) {
						$(element).parent().after('<div class="text-danger">' + json['error'][i] + '</div>');
					} else {
						$(element).after('<div class="text-danger">' + json['error'][i] + '</div>');
					}
				}

				$('.text-danger').parent().addClass('has-error');
            } else {
                // Reload delivery section
                $.ajax({
                    url: 'index.php?route=checkout/shipping_address',
                    dataType: 'html',
                    success: function(html) {
                        $('#delivery-shipping-address').html(html);
                    }
                });
                {% if shipping_required %}
                $.ajax({
                    url: 'index.php?route=checkout/shipping_method',
                    dataType: 'html',
                    success: function(html) {
                        $('#delivery-shipping-method-section .section-content').html(html);
                    }
                });
                {% endif %}

                if ($('input[name=\'billing_address\']:checked').val() == 'same') {
                  syncShippingToPayment();
                }
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>
{{ footer }}
