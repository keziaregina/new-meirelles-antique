{% if error_warning %}
<div class="alert alert-warning alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
{% endif %}
{% if shipping_methods %}
<p>{{ text_shipping_method }}</p>
{% for shipping_method in shipping_methods %}
{% if not shipping_method.error %}
{% for quote in shipping_method.quote %}
<div class="shipping-method-card">
  <label class="shipping-method-option">
    <input type="radio" name="shipping_method" value="{{ quote.code }}" {% if quote.code == code or not code %}checked="checked"{% endif %} />
    <div class="shipping-method-info">
      <strong>{{ quote.title }}</strong>
      <span>{{ shipping_method.title }} - {{ quote.text }}</span>
    </div>
  </label>
</div>
{% endfor %}
{% else %}
<div class="alert alert-danger alert-dismissible">{{ shipping_method.error }}</div>
{% endif %}
{% endfor %}
{% endif %}
<p><strong>Delivery Instructions</strong></p>
<p>
  <textarea name="comment" rows="8" class="form-control">{{ comment }}</textarea>
</p>
<script type="text/javascript"><!--
var shippingMethodTimer = null;
$(document).on('change', 'input[name=\'shipping_method\']', function() {
  clearTimeout(shippingMethodTimer);
  shippingMethodTimer = setTimeout(function() {
    $.ajax({
      url: 'index.php?route=checkout/shipping_method/save',
      type: 'post',
      data: $('#delivery-shipping-method-section input[type=\'radio\']:checked, #delivery-shipping-method-section textarea'),
      dataType: 'json',
      success: function(json) {
        if (!json['redirect'] && !json['error']) {
          $.ajax({
            url: 'index.php?route=checkout/payment_method',
            dataType: 'html',
            success: function(html) {
              updateCheckoutOrder();
              $('#section-payment-method .section-content').html(html);
            }
          });
        }
      }
    });
  }, 600);
});
//--></script>
