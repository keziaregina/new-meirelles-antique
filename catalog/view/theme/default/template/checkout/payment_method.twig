{% if error_warning %}
<div class="alert alert-warning alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
{% endif %}
{% if payment_methods %}
<p>{{ text_payment_method }}</p>
{% for payment_method in payment_methods %}
<div class="payment-method-card">
  <label class="payment-method-option">
    {% if payment_method.code == code or not code %}
    {% set code = payment_method.code %}
    <input type="radio" name="payment_method" value="{{ payment_method.code }}" checked="checked" />
    {% else %}
    <input type="radio" name="payment_method" value="{{ payment_method.code }}" />
    {% endif %}
    <div class="payment-method-info">
      <strong>{{ payment_method.title }}</strong>
      {% if payment_method.terms %}
      <span>{{ payment_method.terms }}</span>
      {% endif %}
    </div>
  </label>
</div>
{% endfor %}
{% endif %}
<script type="text/javascript"><!--
var paymentMethodTimer = null;
$(document).on('change', 'input[name=\'payment_method\']', function() {
  clearTimeout(paymentMethodTimer);
  paymentMethodTimer = setTimeout(function() {
    $.ajax({
      url: 'index.php?route=checkout/payment_method/save',
      type: 'post',
      data: $('#section-payment-method input[type=\'radio\']:checked, #section-payment-method textarea').serialize() + '&agree=1',
      dataType: 'json',
      success: function(json) {
        if (!json['redirect'] && !json['error']) {
          if (typeof loadPaymentButton === 'function') {
            loadPaymentButton();
          }
        }
      }
    });
  }, 600);
});
//--></script>
